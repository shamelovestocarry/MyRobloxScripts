local Players = game:GetService("Players")
local player = Players:FindFirstChild("Shamelovestocarryyou")

if not player then
    return
end

local weaponsToClone = {
    {sourceFolder = {"Assets", "ViewModels", "Bundles", "Keyper"}, name = "Sniper", oldName = "Sniper"},
    {sourceFolder = {"Assets", "ViewModels", "Spooky Skin Case", "Bat Daggers"}, name = "Daggers", oldName = "Daggers"},
    {sourceFolder = {"Assets", "ViewModels", "Skin Case 3", "Fists of Hurt"}, name = "Fists", oldName = "Fists"},
    {sourceFolder = {"Assets", "ViewModels", "Bundles", "Crystal Katana"}, name = "Katana", oldName = "Katana"},
}

local weaponsFolder = player
    :WaitForChild("PlayerScripts")
    :WaitForChild("Assets")
    :WaitForChild("ViewModels")
    :WaitForChild("Weapons")

for _, weapon in ipairs(weaponsToClone) do
    local source = player:WaitForChild("PlayerScripts")
    for _, folderName in ipairs(weapon.sourceFolder) do
        source = source:WaitForChild(folderName)
    end

    local existingWeapon = weaponsFolder:FindFirstChild(weapon.oldName)
    if existingWeapon then
        existingWeapon.Name = "1"
    end

    local newWeapon = source:Clone()
    newWeapon.Name = weapon.name
    newWeapon.Parent = weaponsFolder
end
